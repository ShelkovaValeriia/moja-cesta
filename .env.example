# Optional browser key for address search/reverse lookup and candidate road geometry.
# Restrict this public browser key to your application's origins in Geoapify.
VITE_MAP_GEOAPIFY_KEY=
# Optional production/self-hosted road router. Preview defaults to the rate-limited OSRM demo.
VITE_MAP_OSRM_URL=
# Enable only for a contracted/self-hosted router permitted to process private pickups.
# Requires VITE_MAP_OSRM_URL. Public request maps always use shared stop coordinates.
VITE_MAP_PRIVATE_ROUTING=false
